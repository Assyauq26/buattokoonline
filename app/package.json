{
  "name": "single-store",
  "version": "1.0.1",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1 -p 3000",
    "build": "npm run security:prepare && prisma generate && next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs run",
    "security:prepare": "node scripts/security/prepare-braces.mjs",
    "security:verify": "node scripts/security/prepare-braces.mjs --verify",
    "db:migrate": "prisma migrate deploy",
    "bootstrap": "tsx prisma/bootstrap.ts",
    "lint": "eslint src"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "@radix-ui/react-accordion": "1.2.1",
    "@radix-ui/react-dialog": "1.1.1",
    "@radix-ui/react-label": "2.1.1",
    "@radix-ui/react-slot": "1.1.0",
    "@radix-ui/react-tabs": "1.1.1",
    "bcryptjs": "2.4.3",
    "class-variance-authority": "0.7.0",
    "clsx": "2.1.1",
    "jose": "5.9.6",
    "lucide-react": "0.454.0",
    "next": "15.5.28",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5",
    "tailwind-merge": "2.5.4",
    "tailwindcss-animate": "1.0.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.0.1",
    "@types/bcryptjs": "2.4.6",
    "@types/node": "20.16.11",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.1",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "15.5.28",
    "jsdom": "25.0.1",
    "postcss": "8.5.23",
    "prisma": "5.22.0",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.15",
    "typescript": "5.6.3",
    "vitest": "4.1.12"
  },
  "overrides": {
    "postcss": "$postcss",
    "postcss-selector-parser": "7.1.6"
  },
  "license": "Apache-2.0"
}
